# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/vyaparguru
# Set to "true" to run against an ephemeral in-memory MongoDB (no Docker needed, data lost on exit)
USE_IN_MEMORY_DB=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Internal services
ML_SERVICE_URL=http://localhost:8000

# CORS
CLIENT_URL=http://localhost:5173

# AI (Phase 3/4)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
